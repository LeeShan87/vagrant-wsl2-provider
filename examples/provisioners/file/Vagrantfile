# File Provisioner Example for vagrant-wsl2-provider
# Demonstrates using the file provisioner to upload files to WSL2

Vagrant.configure("2") do |config|
  config.vm.box = "Ubuntu-24.04"

  config.vm.provider "wsl2" do |wsl|
    wsl.distribution_name = "vagrant-wsl2-file-test"
    wsl.version = 2
  end

  # Upload a file to the VM
  config.vm.provision "file", source: "test-file.txt", destination: "/home/vagrant/uploaded-file-test.txt"

  # Verify the file was uploaded
  config.vm.provision "shell", privileged: false, inline: <<-SHELL
    echo "=== File Provisioner Test ==="
    echo "Checking if file was uploaded..."
    if [ -f /home/vagrant/uploaded-file-test.txt ]; then
      echo "File uploaded successfully!"
      echo "Contents:"
      cat /home/vagrant/uploaded-file-test.txt
    else
      echo "ERROR: File not found!"
      exit 1
    fi
  SHELL
end
